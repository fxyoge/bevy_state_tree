<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:bst="urn:bevy-state-tree" bst:domain="test" datamodel="luau">
  <datamodel>
    <data id="count" expr="0"/>
  </datamodel>
  <state id="source">
    <onentry>
      <assign location="count" expr="count + 1"/>
      <raise event="ready"/>
    </onentry>
    <transition event="ready" cond="count == 1" target="done"/>
  </state>
  <final id="done"/>
</scxml>
