<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:bst="urn:bevy-state-tree" bst:domain="test">
  <state id="source">
    <onentry><raise event="first"/></onentry>
    <onentry><raise event="second"/></onentry>
    <transition event="first" target="waiting"/>
  </state>
  <state id="waiting">
    <transition event="second" target="done"/>
  </state>
  <final id="done"/>
</scxml>
