<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:bst="urn:bevy-state-tree" initial="p">
  <parallel id="p">
    <state id="left" initial="left_wait">
      <state id="left_wait">
        <onexit><raise event="exit.left"/></onexit>
        <transition event="tick" target="left_done"><raise event="transition.left"/></transition>
      </state>
      <state id="left_done"><onentry><raise event="enter.left"/></onentry></state>
    </state>
    <state id="right" initial="right_wait">
      <state id="right_wait">
        <onexit><raise event="exit.right"/></onexit>
        <transition event="tick" target="right_done"><raise event="transition.right"/></transition>
      </state>
      <state id="right_done"><onentry><raise event="enter.right"/></onentry></state>
    </state>
  </parallel>
</scxml>
