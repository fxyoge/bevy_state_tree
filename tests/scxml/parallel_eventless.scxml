<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:bst="urn:bevy-state-tree" initial="p">
  <parallel id="p">
    <state id="left" initial="left_boot">
      <state id="left_boot"><transition target="left_ready"/></state>
      <state id="left_ready"/>
    </state>
    <state id="right" initial="right_boot">
      <state id="right_boot"><transition target="right_ready"/></state>
      <state id="right_ready"/>
    </state>
  </parallel>
</scxml>
