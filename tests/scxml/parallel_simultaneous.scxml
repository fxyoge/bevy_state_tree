<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:bst="urn:bevy-state-tree" bst:domain="test" initial="p">
  <parallel id="p">
    <state id="left" initial="left_wait">
      <state id="left_wait">
        <transition event="tick" target="left_done"/>
      </state>
      <state id="left_done"/>
    </state>
    <state id="right" initial="right_wait">
      <state id="right_wait">
        <transition event="tick" target="right_done"/>
      </state>
      <state id="right_done"/>
    </state>
  </parallel>
</scxml>
